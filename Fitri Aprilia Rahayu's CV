<body class="bg-slate-100 text-slate-800 font-sans min-h-screen pb-12">

    <!-- Top Action Toolbar (Floating, Hidden when Printing) -->
    <header class="no-print sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm px-4 py-3 mb-6">
        <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-blue-600 text-white p-2 rounded-lg font-bold">
                    <i class="fa-solid fa-file-invoice"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold text-slate-800">Tugas Informatika: Pembuat CV</h1>
                    <p class="text-xs text-slate-500">Edit data langsung di bawah &amp; simpan ke PDF</p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 flex-wrap">
                <button onclick="toggleEditMode()" id="editToggleBtn" class="flex items-center gap-2 bg-slate-200 hover:bg-slate-300 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium transition">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span id="editBtnText">Mode Edit</span>
                </button>
                <button onclick="window.print()" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-lg text-sm font-semibold shadow-md shadow-blue-500/20 transition">
                    <i class="fa-solid fa-print"></i>
                    <span>Cetak / PDF</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-4xl mx-auto px-4">
        
        <!-- Instruction Banner for Students -->
        <div class="no-print bg-blue-50 border border-blue-200 text-blue-800 rounded-xl p-4 mb-6 text-sm flex items-start gap-3 shadow-sm">
            <i class="fa-solid fa-circle-info text-blue-500 text-lg mt-0.5"></i>
            <div>
                <strong class="font-semibold">Petunjuk Pengisian:</strong>
                <ul class="list-disc list-inside mt-1 space-y-1 text-blue-700 text-xs sm:text-sm">
                    <li>Klik tombol **Mode Edit** atau langsung klik pada teks di CV untuk mengubah data diri Anda.</li>
                    <li>Klik foto profil untuk mengganti dengan foto formal pribadi Anda.</li>
                    <li>Setelah selesai mengedit, Anda dapat langsung mengklik **Cetak / PDF** untuk menyimpan CV.</li>
                </ul>
            </div>
        </div>

        <!-- Resume Document Paper -->
        <div class="cv-container bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200 grid grid-cols-1 md:grid-cols-12 min-h-[900px]">

            <!-- LEFT SIDEBAR / PROFILE INFO (4 Cols) -->
            <aside class="md:col-span-4 bg-slate-900 text-white p-6 md:p-8 flex flex-col justify-between relative">
                
                <div>
                    <!-- Profile Photo Section -->
                    <div class="relative group mx-auto w-36 h-48 sm:w-40 sm:h-52 mb-6 rounded-xl overflow-hidden border-2 border-slate-700 shadow-lg bg-slate-800 flex items-center justify-center">
                        <img id="profileImage" src="data:image/jpeg;base64,
